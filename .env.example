APP_NAME="Студия йоги Ирины Коленцевой"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ekoyoga-ik.ru
APP_TIMEZONE=Europe/Moscow

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="ЭКО YOGA"

# Куда приходят заявки с формы на сайте
STUDIO_LEAD_EMAIL="hello@ekoyoga-ik.ru"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Первый администратор (создаётся через php artisan db:seed)
ADMIN_EMAIL=admin@ekoyoga-ik.ru
ADMIN_PHONE=+79000000000
ADMIN_PASSWORD=StudioAdmin2026!

# Демо-тренер (php artisan db:seed --class=TrainerUserSeeder)
TRAINER_EMAIL=trainer@ekoyoga-ik.ru
TRAINER_PHONE=+79000000001
TRAINER_PASSWORD=StudioTrainer2026!

# Telegram Login Widget — вход и привязка аккаунта
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_AUTH_MAX_AGE=86400
# На VPS в РФ, если Telegram не доходит: принудительный IPv4-адрес API
TELEGRAM_CURL_RESOLVE=api.telegram.org:443:149.154.167.220

# ЮKassa — онлайн-оплата абонементов
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_URL="${APP_URL}/payments/webhook"
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=2
